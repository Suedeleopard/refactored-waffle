# Environment variables — names only, never real values.
#
# Copy to .env.local for development and fill in. In production these live in
# Vercel (Project → Settings → Environment Variables); .env.local is NOT read
# there, so every variable below has to be set in both places.

# ─── Site ────────────────────────────────────────────────────────────────────
# The canonical URL, no trailing slash. Stripe redirects back here after
# checkout and outbound emails link to it, so a wrong value sends buyers to a
# dead page at the worst possible moment.
NEXT_PUBLIC_SITE_URL=https://xbehavinglikey.com

# ─── Supabase (required) ─────────────────────────────────────────────────────
# Without the first two, every route redirects to /setup by design.
# Project → Settings → API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Bypasses row level security — never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# ─── Stripe ──────────────────────────────────────────────────────────────────
# All three must come from the SAME account and mode. A price from one sandbox
# with a key from another fails at checkout with a confusing "no such price".
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# The one-time GBP price for The Kit.
NEXT_PUBLIC_STRIPE_PRICE_STARTER=

# Signing secret for the webhook endpoint (whsec_…). Stripe → Developers →
# Webhooks → your endpoint. Without this the webhook returns early, no
# purchases row is written, and the paywall never unlocks after payment —
# which looks like nothing is wrong until a customer complains.
STRIPE_WEBHOOK_SECRET=

# ─── Resend ──────────────────────────────────────────────────────────────────
# Transactional email. Missing means sends no-op with a console warning rather
# than throwing, so leads are still captured.
RESEND_API_KEY=
